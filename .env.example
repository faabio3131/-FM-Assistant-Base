FM_ASSISTANT_ENV=development
FM_ASSISTANT_DATABASE_URL=sqlite:///./fm_assistant.db
FM_ASSISTANT_ADMIN_KEY=replace-with-strong-admin-key
FM_ASSISTANT_CREDENTIAL_PEPPER=replace-with-long-random-pepper
FM_ASSISTANT_AUTO_CREATE_SCHEMA=1

# Runtime de IA temporário. O destino arquitetural é FM Core Base.
FM_ASSISTANT_MODEL_BACKEND=development
# FM_ASSISTANT_MODEL_BACKEND=openai_compatible
# FM_ASSISTANT_MODEL_BASE_URL=https://api.openai.com/v1
# FM_ASSISTANT_MODEL_API_KEY=...
# FM_ASSISTANT_MODEL_NAME=...
