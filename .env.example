# Um único produto: VendeAtendeIA. O launcher usa uma chave compartilhada para os dois serviços.
FM_VENDEATENDEIA_INTERNAL_KEY=replace-with-a-unique-strong-internal-key-32chars
FM_VENDEATENDEIA_CORE_PORT=8765
FM_VENDEATENDEIA_APP_PORT=8000
# Configure um control plane migrado OU rotas de IA para inicializar o Core:
# FM_CORE_CONTROL_PLANE_DATABASE_URL=sqlite:///./core.db
# FM_CORE_AI_ROUTES_JSON=[...]
FM_ASSISTANT_ENV=development
FM_ASSISTANT_DATABASE_URL=sqlite:///./fm_assistant.db
FM_ASSISTANT_ADMIN_KEY=replace-with-strong-admin-key
FM_ASSISTANT_CREDENTIAL_PEPPER=replace-with-long-random-pepper
FM_ASSISTANT_CHANNEL_ENCRYPTION_KEY=replace-with-fernet-key
FM_ASSISTANT_SESSION_PEPPER=replace-with-long-random-session-pepper
FM_ASSISTANT_SESSION_TTL_MINUTES=480
FM_ASSISTANT_AUTO_CREATE_SCHEMA=1

# Runtime de IA. Staging/produção exigem FM Core Base.
FM_ASSISTANT_MODEL_BACKEND=core
# FM_ASSISTANT_MODEL_BACKEND=core
# FM_ASSISTANT_CORE_BASE_URL=http://fm-core-base:8000
# FM_ASSISTANT_CORE_SERVICE_KEY=...
#
# Compatibilidade direta com provider: somente development/test ou exceção formal:
# FM_ASSISTANT_MODEL_BACKEND=openai_compatible
# FM_ASSISTANT_MODEL_BASE_URL=https://api.openai.com/v1
# FM_ASSISTANT_MODEL_API_KEY=...
# FM_ASSISTANT_MODEL_NAME=...
