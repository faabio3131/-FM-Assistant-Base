FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY services/fm-core/pyproject.toml services/fm-core/README.md ./
COPY services/fm-core/core ./core
COPY services/fm-core/alembic ./alembic
COPY services/fm-core/alembic.ini ./
RUN pip install --no-cache-dir .
EXPOSE 8000
CMD ["uvicorn", "core.ai_service_main:app", "--host", "0.0.0.0", "--port", "8000"]
