# Sample ONLY. Never commit a populated .env, credentials, real domains or tokens.
# Copy to deploy/evolution/.env on the private VPS only, chmod 600.
# Every secret must be independently generated and configured in a real secret manager.
# For DATABASE_CONNECTION_URI interpolation, keep postgres user/password URL-safe
# (e.g. randomly generated ASCII letters and digits; no :, @, /, %, #, ?).
EVOLUTION_PUBLIC_HTTPS_URL=https://evolution.example.invalid
EVOLUTION_ALLOWED_ORIGIN=https://app.example.invalid
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution_local
EVOLUTION_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_DB_PASSWORD
EVOLUTION_MASTER_API_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_64_CHAR_KEY
